Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
<FilesMatch "^(config\..*\.php|composer\..*|.*\.sql|.*\.md)$">
  Require all denied
</FilesMatch>
# A replacement archive must also close legacy assets left on the server.
<Files "demo-mission.mp4">
  Require all denied
</Files>
